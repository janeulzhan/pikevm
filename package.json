{
  "name": "pikevm",
  "version": "0.1.0",
  "private": true,
  "description": "Linear-time regex engine: Thompson NFA plus Pike VM, fuzz-verified against V8",
  "license": "MIT",
  "author": "Ulzhan Khamidolla",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec test/*.test.ts",
