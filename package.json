    "bench": "node bench/redos.ts",
    "bench:ci": "node bench/ci.ts",
    "benchlock": "node tools/benchlock.ts",
    "benchlock:check": "node tools/benchlock.ts --check",
    "build:demo": "node scripts/build-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
