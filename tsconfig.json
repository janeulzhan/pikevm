{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2022.RegExp", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "tools", "bench", "scripts", "docs"]
}
